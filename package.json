{
  "name": "knowledge-qa-assistant",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "db:generate": "supabase migration new",
    "db:migrate": "node --env-file=.env scripts/migrate-supabase.mjs",
    "test:db": "node --env-file=.env scripts/test-supabase.mjs",
    "migrate:legacy": "node --env-file=.env scripts/migrate-legacy.mjs",
    "ingest:pending": "node --env-file=.env --import tsx scripts/process-document-jobs.ts",
    "supabase:start": "node scripts/start-local-supabase.mjs",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:env": "node scripts/local-supabase-env.mjs",
    "test:i18n": "node --import tsx --test packages/i18n/tests/i18n.test.ts",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "turbo": "^2.5.0",
    "typescript-eslint": "^8.72.1"
  }
}
