# 本地 Supabase，由 pnpm supabase:start 自动填充本地 key。
APP_ENV=local
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

COOKIE_DOMAIN=.lvh.me
AUTH_APP_URL=http://auth.lvh.me:3001
WEB_APP_URL=http://app.lvh.me:3100
NEXT_PUBLIC_AUTH_APP_URL=http://auth.lvh.me:3001
NEXT_PUBLIC_WEB_APP_URL=http://app.lvh.me:3100

LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3

# 默认使用本地 Mailpit 捕获邮件（127.0.0.1:55324）。填写以下配置才向真实邮箱外发。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 定时 POST /api/internal/ingest 使用。生产环境必须配置定时调用以恢复中断任务。
INGEST_CRON_SECRET=

# 本地默认阻止文档发送到远程模型。确需远程模型时才设为 true。
ALLOW_REMOTE_AI=false
