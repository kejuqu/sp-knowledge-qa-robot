# Copy these values into Vercel Production environment variables, not the local .env.
APP_ENV=production
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# All four URLs use the SAME Vercel production domain. No trailing slash.
AUTH_APP_URL=https://YOUR_PROJECT.vercel.app
WEB_APP_URL=https://YOUR_PROJECT.vercel.app
NEXT_PUBLIC_AUTH_APP_URL=https://YOUR_PROJECT.vercel.app
NEXT_PUBLIC_WEB_APP_URL=https://YOUR_PROJECT.vercel.app
# Leave empty: the browser uses a host-only cookie.
COOKIE_DOMAIN=

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
INGEST_CRON_SECRET=
